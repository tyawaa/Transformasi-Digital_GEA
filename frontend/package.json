{
  "name": "gea-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "base64-js": "1.5.1",
    "expo": "^58",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-location": "~58.0.22",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-task-manager": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "^6.3.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.3",
    "@types/node": "26.6.6",
    "@types/react": "~19.3.0",
    "cloudflared": "0.7.3",
    "expo-doctor": "1.21.5",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-view-shot"
      ]
    }
  },
  "scripts": {
    "start": "expo start --go",
    "start:tunnel": "expo start --go --tunnel --clear",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android --output-dir dist/android --max-workers 2",
    "export:web": "expo export --platform web --output-dir dist/web --max-workers 2",
    "export:demo": "node scripts/export-demo.mjs",
    "demo": "powershell -NoProfile -File scripts/serve-demo.ps1",
    "test": "node --test tests/*.test.mjs"
  },
  "private": true
}
