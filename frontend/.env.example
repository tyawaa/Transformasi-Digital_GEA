# Salin ke .env lalu ganti URL dan publishable key dengan konfigurasi project tim.
# Kedua nilai wajib terisi, termasuk saat memakai mock.
EXPO_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=ISI_PUBLISHABLE_KEY_DARI_TIM

# mock = simulasi untuk pengembangan; kosong = backend API.
EXPO_PUBLIC_STORIES_SOURCE=mock
EXPO_PUBLIC_MAP_WINGS=both
